# signal-summarizer on an Android phone.
# Copy to ~/signal-summarizer.env and set SIGNAL_ACCOUNT.

# The number signal-cli is linked to.
SIGNAL_ACCOUNT=

SIGNAL_RPC_ADDRESS=tcp://127.0.0.1:7583
SUMMARIZER_DB="$HOME/.signal-summarizer/history.db"

# Run the model as a one-off process per summary: nothing stays resident, so
# Android has no 1 GB server to kill while you are using other apps. The
# weights are mmapped, so a reload costs a second or two.
# Quoted because this file is sourced by the shell.  Flag names move around
# between llama.cpp releases — `signal-summarizer check` runs exactly this
# command, so use it to confirm the flags your build accepts.
SUMMARIZER_BACKEND=command
EDGE_COMMAND="$HOME/llama.cpp/build/bin/llama-cli -hf bartowski/Llama-3.2-1B-Instruct-GGUF:Q4_K_M -c 4096 -n 512 --temp 0.2 -no-cnv --no-display-prompt -f /dev/stdin"

# Alternative: keep llama-server resident (faster per summary, ~1 GB held).
#   llama-server -hf bartowski/Llama-3.2-1B-Instruct-GGUF:Q4_K_M -c 4096 --port 8080
# SUMMARIZER_BACKEND=openai
# EDGE_ENDPOINT=http://127.0.0.1:8080/v1

# Match -c above. A 1B model on a phone does roughly 10-30 tokens/second, so
# keep the window small; the bot splits anything larger into several passes.
EDGE_CONTEXT_TOKENS=4096
EDGE_OUTPUT_TOKENS=512
EDGE_TIMEOUT=600

# Phone-sized defaults: shorter windows, fewer messages per pass, and a
# "working on it" reply early since a summary here takes tens of seconds.
SUMMARIZER_WINDOW_HOURS=12
SUMMARIZER_MAX_MESSAGES=150
SUMMARIZER_ACK_MESSAGES=20
SUMMARIZER_RETENTION_DAYS=14

# Strongly recommended on a phone: only record and answer in chats you list
# here, so the bot is not transcribing every conversation on the device.
# SUMMARIZER_ALLOWED_CHATS=group:Zm9vYmFy
